# Gutter - Journal Configuration

# Server
PORT=3000
HOST=localhost

# Auth (single user — set password hash to enable, leave empty to disable)
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_PASSWORD_HASH=
# Required when AUTH_PASSWORD_HASH is set; use a long, random installation secret.
AUTH_SECRET=
SESSION_MAX_AGE_DAYS=30

# Database
DATABASE_PATH=./gutter-journal.db
BACKUP_DIR=./backups

# Theme (optional - defaults to cyberpink)
DEFAULT_THEME=cyberpink

# Apple Calendars to sync (comma-separated names)
CALENDARS=Calendar,Family Calendar,Home,JW,School
# Optional accli command override; defaults to this npx package command.
CALENDAR_CLI=npx @joargp/accli

# Optional local workspace root; defaults to ~/.openclaw/workspace.
# Overrides must be absolute paths.
OPENCLAW_WORKSPACE_PATH=
# Optional local agent transcript root; defaults to ~/.openclaw/agents.
OPENCLAW_AGENTS_PATH=

# Ollama (AI features)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
JOURNAL_COMMAND_MODEL=qwen3:latest
NEXT_PUBLIC_JOURNAL_TIME_ZONE=America/Cancun

# Jira (meeting prep context)
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECTS=GDEV,ISE

# Slack (meeting prep context)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNELS=C029BN2FBPD|team-hardcore-developer-chat,C027SHEDUET|team-senior-devs

# Whisper (voice transcription). Model defaults to
# ~/.cache/whisper/ggml-base.en.bin; path overrides must be absolute.
WHISPER_MODEL_PATH=
# Optional executable overrides; defaults resolve these commands from PATH.
BUN_BIN=bun
FFMPEG_BIN=ffmpeg
WHISPER_BIN=whisper-cli
